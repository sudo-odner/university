<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F6F0"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fitsSystemWindows="true"
        android:paddingBottom="60dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rootContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineCenter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.55" />

            <!-- LEFT COLUMN: Configurator -->

            <TextView
                android:id="@+id/tvClassLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_car_class"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupClass"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true"
                app:layout_constraintEnd_toStartOf="@id/guidelineCenter"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvClassLabel">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipClassEconomy"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:text="🚗 Эконом"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_text_color"
                    android:textSize="14sp"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconEnabled="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipClassComfort"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:text="🚖 Комфорт"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_text_color"
                    android:textSize="14sp"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconEnabled="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipClassBusiness"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:text="💼 Бизнес"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_text_color"
                    android:textSize="14sp"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconEnabled="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipClassMinivan"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:text="🚐 Минивэн"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_text_color"
                    android:textSize="14sp"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconEnabled="false" />

            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/tvZoneLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/section_tariff_zone"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/chipGroupClass" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupZone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true"
                app:layout_constraintEnd_toStartOf="@id/guidelineCenter"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvZoneLabel">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipZoneCity"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="🏙️ Город (10 км, 15 мин)"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_text_color"
                    android:textSize="14sp"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconEnabled="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipZoneSuburb"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="🏞️ Загород (25 км, 30 мин)"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_text_color"
                    android:textSize="14sp"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconEnabled="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipZoneAirport"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="✈️ Аэропорт (40 км, 45 мин)"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_text_color"
                    android:textSize="14sp"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconEnabled="false" />

            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/tvOptionsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/section_options"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/chipGroupZone" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupOptions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toStartOf="@id/guidelineCenter"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvOptionsLabel">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipOptChildSeat"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="👶 Детское кресло (+150 ₽)"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_text_color"
                    android:textSize="14sp"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconEnabled="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipOptBaggage"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="🧳 Крупный багаж (+200 ₽)"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_text_color"
                    android:textSize="14sp"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconEnabled="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipOptPets"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="🐾 Питомец (+150 ₽)"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_text_color"
                    android:textSize="14sp"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconEnabled="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipOptExpress"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="⚡ Экспресс (+250 ₽)"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_text_color"
                    android:textSize="14sp"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconEnabled="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipOptSilent"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="🤫 Тихий водитель (+50 ₽)"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_text_color"
                    android:textSize="14sp"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconEnabled="false" />

            </com.google.android.material.chip.ChipGroup>

            <!-- RIGHT COLUMN: Panel -->

            <TextView
                android:id="@+id/tvPassengersLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="👥  Пассажиров"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/guidelineCenter"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/passengerCounterLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintStart_toEndOf="@id/guidelineCenter"
                app:layout_constraintTop_toBottomOf="@id/tvPassengersLabel">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDecrementPassengers"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="-"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    app:cornerRadius="26dp" />

                <TextView
                    android:id="@+id/tvPassengerCount"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="1 пассажир"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIncrementPassengers"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="+"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    app:cornerRadius="26dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvDemandLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:text="@string/section_demand"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/guidelineCenter"
                app:layout_constraintTop_toBottomOf="@id/passengerCounterLayout" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupDemand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/guidelineCenter"
                app:layout_constraintTop_toBottomOf="@id/tvDemandLabel">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDemandNormal"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="🟢 Обычный (1.0x)"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_text_color"
                    android:textSize="14sp"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconEnabled="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDemandHigh"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="🟡 Высокий (1.3x)"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_text_color"
                    android:textSize="14sp"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconEnabled="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDemandPeak"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="🔴 Пиковый (1.8x)"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_text_color"
                    android:textSize="14sp"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconEnabled="false" />

            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/tvBreakdownLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:text="@string/section_breakdown"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/guidelineCenter"
                app:layout_constraintTop_toBottomOf="@id/chipGroupDemand" />

            <com.example.lab1.view.TaxiPriceBreakdownView
                android:id="@+id/priceBreakdownView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="8dp"
                android:padding="8dp"
                app:animateChanges="true"
                app:barHeight="32dp"
                app:baseColor="@color/chart_base"
                app:distanceColor="@color/chart_distance"
                app:optionsColor="@color/chart_options"
                app:showLabels="true"
                app:timeColor="@color/chart_time"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/guidelineCenter"
                app:layout_constraintTop_toBottomOf="@id/tvBreakdownLabel" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/guidelineCenter"
                app:layout_constraintTop_toBottomOf="@id/priceBreakdownView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Итоговая стоимость:"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvTotalPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 ₽"
                            android:textColor="@color/text_primary"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnProceed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="@color/primary"
                        android:minHeight="52dp"
                        android:text="@string/btn_proceed"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="14dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
